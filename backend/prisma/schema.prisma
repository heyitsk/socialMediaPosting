generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  THREADS
  YOUTUBE
  PINTEREST
  LINKEDIN
}

// Drives refresh-job branching instead of scattering per-platform `if`s
// through the codebase — see websitePlan.md §7.
enum RefreshStrategy {
  NONE // Facebook/Instagram — Page token effectively non-expiring
  SLIDING_WINDOW // Threads/Pinterest — proactively refreshed before expiry
  ON_DEMAND // YouTube — refresh token exchanged right before each use
  REQUIRES_RECONNECT // LinkedIn — 60-day token, no refresh token at all; member must redo OAuth consent
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
  REELS
  STORIES
  // YouTube-only. The API has no Shorts flag — YouTube classifies a video as
  // a Short itself (vertical/square, ≤3 min). This just tags the description
  // with #Shorts and tells the composer which guidance to show.
  SHORTS
}

// Distinguishes how an Instagram ConnectedAccount was linked — the two paths
// issue tokens scoped to different Graph API hosts and different platform
// account ID namespaces for the same physical account (see instagram.ts).
enum ConnectionMethod {
  FACEBOOK_PAGE
  INSTAGRAM_LOGIN
  THREADS_LOGIN
  LINKEDIN_LOGIN
  YOUTUBE_LOGIN
}

// Owner is not a role — it's Workspace.ownerUserId, so there's exactly one
// source of truth for it. Everyone else has one of these. websitePlan.md §9.7.
enum WorkspaceRole {
  ADMIN // Owner's deputy — connects/disconnects platform accounts
  MEMBER // Composes and publishes with the workspace's accounts
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PUBLISHED
  PARTIAL_FAILURE
  FAILED
  CANCELLED // Scheduled post cancelled before it was sent
}

// What the user picked first in the composer — one per PostGroup. Mapped to
// each target's platform-specific MediaType by lib/capabilities.ts (e.g.
// VIDEO becomes Instagram REELS). websitePlan.md §10.3.
enum ContentKind {
  TEXT
  IMAGE
  CAROUSEL
  VIDEO
  STORY
}

enum MediaAssetStatus {
  PENDING // Upload URL handed out, bytes not verified yet
  READY // HEAD + content check passed
  DELETED // Object removed from S3 — row kept for history
}

enum PostLogStatus {
  SUCCESS
  FAILED
}

// How a rendition is made from its master. websitePlan.md §12.
enum CooldownReason {
  ABUSE_BLOCK // Meta code 368 "spam prevention"
  RATE_LIMIT // Throttled (429, Meta 4/17/32/613), usually short
  QUOTA // A daily or rolling posting quota is used up
}

enum RenditionMode {
  CROP // Keep a region of the master, scaled to the output size
  PAD // Whole master centred on a blurred, zoomed copy of itself
  CONVERT // Same picture re-encoded as JPEG (Instagram takes JPEG only)
}

enum RenditionStatus {
  PENDING // Queued for the render worker
  READY
  FAILED
  DELETED // Object removed from S3 along with its master
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  // Google's stable account id — users are matched on this, not email
  // (emails can change/be reassigned). Null only for the pre-login seeded
  // user until its first Google sign-in links it (websitePlan.md §9.4).
  googleSub   String?   @unique @map("google_sub")
  avatarUrl   String?   @map("avatar_url")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  memberships     Membership[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  sentInvites     WorkspaceInvite[]
  posts           Post[]
  postGroups      PostGroup[]
  mediaAssets     MediaAsset[]

  @@map("users")
}

// The tenant. Connected accounts and posts belong to a workspace, not a user,
// so an agency employee can be a member of several client workspaces. Every
// signup gets an auto-created "Personal" one — websitePlan.md §9.
model Workspace {
  id          String    @id @default(uuid())
  name        String
  // Exactly one owner, never transferred. Only the owner manages members,
  // invites, and renames/deletes the workspace (websitePlan.md §9.7).
  ownerUserId String    @map("owner_user_id")
  owner       User      @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  // The auto-created one every user gets at signup. Single-user: no invites,
  // can't be deleted. At most one per owner (partial unique index in SQL).
  isPersonal  Boolean   @default(false) @map("is_personal")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Soft delete. A deleted workspace is invisible everywhere — getMembership()
  // treats it as "not a member" — but its rows stay.
  deletedAt   DateTime? @map("deleted_at")

  memberships       Membership[]
  invites           WorkspaceInvite[]
  connectedAccounts ConnectedAccount[]
  posts             Post[]
  postGroups        PostGroup[]
  mediaAssets       MediaAsset[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Ignored for the owner — see WorkspaceRole.
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

// Accepted automatically when someone signs in with Google using this
// (verified) email. Re-inviting the same email refreshes the same row.
model WorkspaceInvite {
  id              String        @id @default(uuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Stored lowercased.
  email           String
  // Copied onto the Membership when the invite is accepted.
  role            WorkspaceRole @default(MEMBER)
  invitedByUserId String        @map("invited_by_user_id")
  invitedBy       User          @relation(fields: [invitedByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  expiresAt       DateTime      @map("expires_at")
  acceptedAt      DateTime?     @map("accepted_at")

  @@unique([workspaceId, email])
  @@index([email])
  @@map("workspace_invites")
}

model ConnectedAccount {
  id                String           @id @default(uuid())
  workspaceId       String           @map("workspace_id")
  workspace         Workspace        @relation(fields: [workspaceId], references: [id])
  platform          Platform
  accountName       String           @map("account_name")
  platformAccountId String           @map("platform_account_id")
  connectionMethod  ConnectionMethod @default(FACEBOOK_PAGE) @map("connection_method")

  // AES-256-GCM encrypted (nonce || ciphertext || authTag, base64) — see
  // websitePlan.md §7 "Token Encryption Scheme". Never touches the frontend or n8n.
  encryptedAccessToken  String  @map("encrypted_access_token")
  encryptedRefreshToken String? @map("encrypted_refresh_token")

  // Which key encrypted this row's tokens — enables zero-downtime key rotation.
  keyVersion Int @map("key_version")

  tokenExpiresAt  DateTime?       @map("token_expires_at")
  refreshStrategy RefreshStrategy @map("refresh_strategy")
  lastRefreshedAt DateTime?       @map("last_refreshed_at")

  // Soft-delete marker. "Disconnect" sets this instead of deleting the row —
  // posts.connected_account_id is RESTRICT, so a hard delete fails once the
  // account has post history. Reconnecting via OAuth upserts on the same
  // composite key and clears this field. Disconnecting also blanks the token
  // columns (service/connected-accounts.ts): encryptedAccessToken is NOT NULL,
  // so "no token" is the empty string.
  disconnectedAt DateTime? @map("disconnected_at")

  // The Facebook user who connected this Page (and its Instagram account) —
  // the app-scoped id Meta's deauthorize/data-deletion callbacks identify
  // people by, which is not the Page id stored above. Only set on
  // FACEBOOK_PAGE rows, and only for connections made after it was added.
  metaUserId String? @map("meta_user_id")

  posts Post[]

  // Facebook-Page-linked and standalone-Instagram-Login flows can both
  // resolve to the SAME platformAccountId for the same physical Instagram
  // account (it's a stable per-account ID in Meta's API, not per-auth-method)
  // — connectionMethod must be part of the key or one flow's upsert clobbers
  // the other's token.
  @@unique([workspaceId, platform, platformAccountId, connectionMethod])
  @@index([metaUserId])
  @@map("connected_accounts")
}

// One composer submission — the same content sent to one or more connected
// accounts. Each target is a Post row; status here is aggregated from them by
// recomputeGroupStatus (service/post-groups.ts). websitePlan.md §10.
model PostGroup {
  id              String      @id @default(uuid())
  workspaceId     String      @map("workspace_id")
  workspace       Workspace   @relation(fields: [workspaceId], references: [id])
  createdByUserId String      @map("created_by_user_id")
  createdBy       User        @relation(fields: [createdByUserId], references: [id])
  contentKind     ContentKind @map("content_kind")
  // Shared caption — a target's Post.caption holds its override if it has one.
  caption         String
  mediaUrls       Json        @map("media_urls")
  status          PostStatus  @default(PROCESSING)
  // Null = post now.
  scheduledFor    DateTime?   @map("scheduled_for")
  // Generated by the composer when the form loads, so a double-click or a
  // network retry returns the existing group instead of publishing twice.
  idempotencyKey  String      @map("idempotency_key")
  cancelledAt     DateTime?   @map("cancelled_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  posts Post[]
  // Uploaded media, ordered by position. Empty for TEXT posts and for groups
  // created before S3 uploads (those keep their public URLs in mediaUrls).
  media MediaAsset[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@map("post_groups")
}

// One target of a PostGroup: one connected account.
model Post {
  id                 String           @id @default(uuid())
  groupId            String           @map("group_id")
  group              PostGroup        @relation(fields: [groupId], references: [id])
  workspaceId        String           @map("workspace_id")
  workspace          Workspace        @relation(fields: [workspaceId], references: [id])
  // Which member posted — the workspace owns the post, this is attribution.
  createdByUserId    String           @map("created_by_user_id")
  createdBy          User             @relation(fields: [createdByUserId], references: [id])
  connectedAccountId String           @map("connected_account_id")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id])
  caption            String
  mediaType          MediaType        @map("media_type")
  mediaUrls          Json             @map("media_urls")
  status             PostStatus       @default(DRAFT)
  scheduledFor       DateTime?        @map("scheduled_for")
  // Platform-specific fields the shared caption/media columns can't hold —
  // currently only YouTube's { title, privacyStatus, madeForKids, tags }.
  // Validated per platform in routes/posts.ts, not by the DB.
  platformOptions    Json?            @map("platform_options")
  // Bumped by each manual retry. Publish/deadline job ids include it, and a
  // deadline job from an older attempt is ignored.
  attempt            Int              @default(1)
  // When this attempt was handed to n8n — null until then, cleared by a
  // retry. Tells the reconciler a never-sent target (safe to queue again)
  // from one waiting on its callback (websitePlan.md §6).
  dispatchedAt       DateTime?        @map("dispatched_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  logs          PostLog[]
  // Files this target sends as a rendition instead of the master.
  renditions    PostMediaRendition[]
  // Posting-limit reservations, one per attempt (websitePlan.md §13).
  dispatchSlots DispatchSlot[]

  @@index([groupId])
  @@map("posts")
}

model PostLog {
  id             String        @id @default(uuid())
  postId         String        @map("post_id")
  post           Post          @relation(fields: [postId], references: [id])
  platform       Platform
  status         PostLogStatus
  platformPostId String?       @map("platform_post_id")
  errorMessage   String?       @map("error_message")
  executedAt     DateTime      @default(now()) @map("executed_at")

  @@map("post_logs")
}

// One file the composer uploaded straight to S3 (websitePlan.md §11). The
// bytes live in S3 under `key`; this row is how we know the object exists and
// who owns it — the bucket is never listed.
model MediaAsset {
  id                String           @id @default(uuid())
  workspaceId       String           @map("workspace_id")
  workspace         Workspace        @relation(fields: [workspaceId], references: [id])
  uploadedByUserId  String           @map("uploaded_by_user_id")
  uploadedBy        User             @relation(fields: [uploadedByUserId], references: [id])
  // Set when a post is created with it. An asset belongs to one post only —
  // there's no media library yet.
  groupId           String?          @map("group_id")
  group             PostGroup?       @relation(fields: [groupId], references: [id])
  position          Int?
  // `<workspaceId>/<id>.<ext>` — generated here, never the user's filename.
  key               String           @unique
  // Only shown back to the user.
  originalFilename  String           @map("original_filename")
  contentType       String           @map("content_type")
  sizeBytes         Int              @map("size_bytes")
  status            MediaAssetStatus @default(PENDING)
  // Videos upload in parts; null for images (single presigned POST).
  multipartUploadId String?          @map("multipart_upload_id")
  // As displayed (EXIF orientation / rotation flag applied), read when the
  // upload completes. Null for uploads from before the probe existed.
  width             Int?
  height            Int?
  // Videos only.
  durationSeconds   Float?           @map("duration_seconds")
  // Set when attached to a post: 15 days after it's sent. The media cleaner
  // deletes the object after this.
  expiresAt         DateTime?        @map("expires_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  completedAt       DateTime?        @map("completed_at")
  deletedAt         DateTime?        @map("deleted_at")

  renditions     MediaRendition[]
  postRenditions PostMediaRendition[]

  @@index([groupId])
  @@index([status, createdAt])
  @@map("media_assets")
}

// A version of a master upload fitted to one platform shape — cropped,
// padded or converted to JPEG (websitePlan.md §12). Rendered by
// queue/render-worker.ts right after the post is created. Targets asking for
// the same thing share one rendition (unique specHash per master).
model MediaRendition {
  id           String          @id @default(uuid())
  mediaAssetId String          @map("media_asset_id")
  mediaAsset   MediaAsset      @relation(fields: [mediaAssetId], references: [id])
  // Hash of everything below that shapes the output.
  specHash     String          @map("spec_hash")
  mode         RenditionMode
  // CROP only: the region kept, as fractions (0-1) of the master as displayed.
  cropX        Float?          @map("crop_x")
  cropY        Float?          @map("crop_y")
  cropW        Float?          @map("crop_w")
  cropH        Float?          @map("crop_h")
  // Output pixels (even, never upscaled). CONVERT keeps the master's size.
  width        Int
  height       Int
  contentType  String          @map("content_type")
  // `<workspaceId>/<mediaAssetId>/r/<specHash>.<jpg|mp4>`
  key          String          @unique
  status       RenditionStatus @default(PENDING)
  sizeBytes    Int?            @map("size_bytes")
  error        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  completedAt  DateTime?       @map("completed_at")

  posts PostMediaRendition[]

  @@unique([mediaAssetId, specHash])
  @@index([status])
  @@map("media_renditions")
}

// Which rendition a target sends for one of the group's files. No row means
// the master goes out as uploaded.
model PostMediaRendition {
  postId       String         @map("post_id")
  post         Post           @relation(fields: [postId], references: [id])
  mediaAssetId String         @map("media_asset_id")
  mediaAsset   MediaAsset     @relation(fields: [mediaAssetId], references: [id])
  renditionId  String         @map("rendition_id")
  rendition    MediaRendition @relation(fields: [renditionId], references: [id])

  @@id([postId, mediaAssetId])
  @@index([renditionId])
  @@map("post_media_renditions")
}

// One per target attempt that the posting limiter let through, at the time it
// may go out (websitePlan.md §13.5). Usage in a window is the sum of `cost`
// over unreleased slots, so scheduled posts count against the day they're sent.
// Keyed on the platform's own account id, not the ConnectedAccount row: the
// same Page connected in two workspaces shares one budget.
model DispatchSlot {
  id                String    @id @default(uuid())
  platform          Platform
  // "*" is the app-wide budget (YouTube's project quota), taken as well as
  // the channel's own slot.
  platformAccountId String    @map("platform_account_id")
  postId            String    @map("post_id")
  post              Post      @relation(fields: [postId], references: [id])
  attempt           Int
  // 1 per post, except LinkedIn (API calls). See lib/posting-limits.ts.
  cost              Int
  slotAt            DateTime  @map("slot_at")
  // Normalized caption + media fingerprints, for the 24 h duplicate guard.
  contentHash       String    @map("content_hash")
  // Set when the target failed or was cancelled before reaching n8n — the
  // platform never saw it, so it stops counting.
  releasedAt        DateTime? @map("released_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([postId, attempt, platformAccountId])
  @@index([platform, platformAccountId, slotAt])
  @@map("dispatch_slots")
}

// A platform account the limiter won't send to until `until` (websitePlan.md
// §13.7). One row per account; a newer block overwrites it.
model AccountCooldown {
  platform          Platform
  platformAccountId String         @map("platform_account_id")
  until             DateTime
  reason            CooldownReason
  // Shown to the user as is.
  message           String
  // The target whose failure started it. Plain id, not a relation — only
  // kept for debugging.
  sourcePostId      String?        @map("source_post_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@id([platform, platformAccountId])
  @@map("account_cooldowns")
}
