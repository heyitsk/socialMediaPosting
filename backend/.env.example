PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://smposting:smposting@localhost:5433/smposting

REDIS_HOST=localhost
REDIS_PORT=6380

# 32 random bytes, base64 — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_V1=

# ngrok (or similar) HTTPS URL tunneling to this backend — Meta rejects
# localhost OAuth redirect URIs. Must also be registered as a valid OAuth
# redirect URI in the Meta App dashboard (<PUBLIC_BACKEND_URL>/api/auth/facebook/callback).
PUBLIC_BACKEND_URL=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Single-user mode (no login yet) — this row is looked up/created lazily
# and every ConnectedAccount is attached to it.
DEFAULT_USER_EMAIL=
DEFAULT_USER_NAME=
