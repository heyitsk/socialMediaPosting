PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://smposting:smposting@localhost:5433/smposting

REDIS_HOST=localhost
REDIS_PORT=6380

# 32 random bytes, base64 — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_V1=

# ngrok (or similar) HTTPS URL tunneling to this backend — Meta rejects
# localhost OAuth redirect URIs. Must also be registered as a valid OAuth
# redirect URI in the Meta App dashboard (<PUBLIC_BACKEND_URL>/api/auth/facebook/callback).
PUBLIC_BACKEND_URL=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# From the Meta App dashboard's "Instagram API setup with Instagram Login"
# product — separate credentials from META_APP_ID/SECRET above. Used for
# standalone Instagram accounts with no linked Facebook Page. Redirect URI to
# register: <PUBLIC_BACKEND_URL>/api/auth/instagram/callback.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# From the same Meta App's "Threads API" product — separate credentials
# again, own OAuth dialog on threads.net. Redirect URI to register:
# <PUBLIC_BACKEND_URL>/api/auth/threads/callback. Your Meta account needs to
# be added as a Threads tester on the app until it's live.
THREADS_APP_ID=
THREADS_APP_SECRET=

# From a standalone LinkedIn App (developer.linkedin.com) — not a Meta App.
# Needs the "Sign In with LinkedIn using OpenID Connect" and "Share on
# LinkedIn" products added. Redirect URI to register:
# <PUBLIC_BACKEND_URL>/api/auth/linkedin/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# From a Google Cloud project (console.cloud.google.com) with "YouTube Data
# API v3" enabled — APIs & Services → Credentials → OAuth client ID → "Web
# application". Redirect URI to register:
# <PUBLIC_BACKEND_URL>/api/auth/youtube/callback. While the OAuth consent
# screen is in "Testing", add your Google account as a test user — and note
# Google expires refresh tokens after 7 days in that mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single-user mode (no login yet) — this row is looked up/created lazily
# and every ConnectedAccount is attached to it.
DEFAULT_USER_EMAIL=
DEFAULT_USER_NAME=

# If n8n runs in Docker on this same machine, use http://localhost:<port> directly
# (no tunnel needed — ngrok free plan only allows one domain, already used by PUBLIC_BACKEND_URL).
# Only use a public tunnel URL here if n8n runs on a different machine.
N8N_BASE_URL=
# Shared secret — must also be set as CALLBACK_SECRET in the n8n container's env
# and referenced by the "Send Callback"/"Send Error Callback" nodes in facebook-poster.json
N8N_CALLBACK_SECRET=
