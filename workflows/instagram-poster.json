                  "leftValue": "",
                  "typeValidation": "loose"
                }
              }
            },
            {
              "outputKey": "STORIES",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "mt-stories",
                    "leftValue": "={{ $json.media_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "singleValue": true
                    },
                    "rightValue": "STORIES"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              }
            }
          ]
        },
