              "outputKey": "IMAGE",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "mt-image",
                    "leftValue": "={{ $json.media_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "singleValue": true
                    },
                    "rightValue": "IMAGE"
