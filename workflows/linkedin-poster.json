    {
      "id": "li-split-video-parts",
      "name": "Split Video Into Parts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "jsCode": "// Merge Video Upload gives us one item: json = LI Init Video Upload's response\n// (value.uploadInstructions[]), binary.data = the full downloaded video file.\n// LinkedIn splits uploads over 4,194,304 bytes into multiple byte-range parts —\n// fan this out into one item per part, each carrying its own byte-range slice\n// of the video as binary data, so the next HTTP Request node PUTs each part\n// to its own uploadUrl (n8n runs a node once per input item automatically).\nconst item = $input.first();\nconst instructions = item.json.value.uploadInstructions;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst mimeType = (item.binary && item.binary.data && item.binary.data.mimeType) || 'video/mp4';\n\nconst output = [];\nfor (let i = 0; i < instructions.length; i++) {\n  const part = instructions[i];\n  const chunk = buffer.subarray(part.firstByte, part.lastByte + 1);\n  const binaryData = await this.helpers.prepareBinaryData(chunk, `part-${i}.bin`, mimeType);\n  output.push({\n    json: {\n      partIndex: i,\n      uploadUrl: part.uploadUrl,\n      firstByte: part.firstByte,\n      lastByte: part.lastByte\n    },\n    binary: { data: binaryData }\n  });\n}\nreturn output;"
      },
      "notes": "Fans out into 1 item per uploadInstructions entry (usually 1, but LinkedIn splits files over 4 MiB into multiple byte-range parts). Uses this.helpers.getBinaryDataBuffer/prepareBinaryData per n8n's Code node cookbook."
    },
    {
      "id": "li-upload-video-binary",
      "name": "LI Upload Video Binary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        400
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.uploadUrl }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Parse Request').first().json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "={{ $binary.data.mimeType || 'video/mp4' }}"
