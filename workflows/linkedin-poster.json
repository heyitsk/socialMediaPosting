    {
      "id": "li-split-carousel-urls",
      "name": "Split Carousel URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        640
      ],
      "parameters": {
        "jsCode": "// Fan media_urls[] out into one item per photo, so the parallel init/download\n// branches below run once per photo (n8n runs a node once per input item),\n// same pattern as the video multi-part fix. LinkedIn's MultiImage content type\n// needs 2-20 images — not strictly validated here, LinkedIn will reject otherwise.\nconst req = $('Parse Request').first().json;\nconst urls = req.media_urls || [];\nreturn urls.map((url, i) => ({ json: { media_url: url, carousel_index: i } }));"
      },
      "notes": "One item per media_urls[] entry. LinkedIn's MultiImage requires 2-20 images."
    },
