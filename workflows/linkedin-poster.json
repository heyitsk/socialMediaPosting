        "jsCode": "// One item per uploaded part, in the same order Split Video Into Parts emitted\n// them in — collapse into a single ordered uploadedPartIds array for finalizeUpload.\nconst items = $input.all();\nconst uploadedPartIds = items.map((item) => {\n  const headers = item.json.headers || {};\n  return headers['etag'] || headers['Etag'] || headers['ETag'];\n});\nreturn [{ json: { uploadedPartIds } }];"
