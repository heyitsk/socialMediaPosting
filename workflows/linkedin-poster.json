      "parameters": {
        "jsCode": "// One item per photo went through LI Init Image Upload (Carousel), in\n// media_urls[] order — pull each item's image urn back out in that same\n// order to build the multiImage.images array finalize/publish needs.\nconst initItems = $('LI Init Image Upload (Carousel)').all();\nconst images = initItems.map((item) => ({ id: item.json.value.image }));\nreturn [{ json: { images } }];"
