              "name": "access_token",
              "value": "={{ $('Parse Request').first().json.access_token }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Parse Request').first().json.content, attached_media: $json.id.map(pid => ({ media_fbid: pid })) }) }}"
      }
    },
    {
      "id": "fb-publish-video",
      "name": "Publish Video Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        320
      ],
      "parameters": {
