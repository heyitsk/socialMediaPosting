        "url": "={{ 'https://graph.facebook.com/v23.0/' + $('Parse Request').first().json.page_id + '/videos' }}",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $('Parse Request').first().json.access_token }}"
            },
            {
              "name": "file_url",
              "value": "={{ $('Parse Request').first().json.media_urls[0] }}"
            },
            {
              "name": "description",
              "value": "={{ $('Parse Request').first().json.content }}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Hosted-video-by-URL upload. Large/long videos may need the resumable upload API instead \u2014 revisit if this times out in practice."
    },
    {
      "id": "build-error-unsupported",
      "name": "Build Error Result (Unsupported Type)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        520
      ],
      "parameters": {
        "jsCode": "const req = $('Parse Request').first().json;\nreturn [{\n  json: {\n    post_id: req.post_id,\n    platform: 'facebook',\n    status: 'FAILED',\n    platform_post_id: null,\n    error: `Unsupported media_type: ${req.media_type}`,\n    callback_url: req.callback_url\n  }\n}];"
      }
    },
    {
      "id": "build-success-result",
      "name": "Build Success Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "const req = $('Parse Request').first().json;\nreturn [{\n  json: {\n    post_id: req.post_id,\n    platform: 'facebook',\n    status: 'SUCCESS',\n    platform_post_id: $json.id,\n    error: null,\n    callback_url: req.callback_url\n  }\n}];"
      }
    },
    {
      "id": "send-callback",
      "name": "Send Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callback_url }}",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_id: $json.post_id, platform: $json.platform, status: $json.status, platform_post_id: $json.platform_post_id, error: $json.error }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -260,
        700
      ],
      "parameters": {}
    },
    {
      "id": "build-error-from-trigger",
      "name": "Build Error Result (From Trigger)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        700
      ],
      "parameters": {
        "jsCode": "const runData = $json.execution?.data?.executionData?.resultData?.runData;\nconst parsed = runData?.['Parse Request']?.[0]?.data?.main?.[0]?.[0]?.json || {};\nreturn [{\n  json: {\n    post_id: parsed.post_id ?? null,\n    platform: 'facebook',\n    status: 'FAILED',\n    platform_post_id: null,\n    error: ($json.execution?.error?.message || 'Unknown error') + ' (last node: ' + ($json.execution?.lastNodeExecuted || 'unknown') + ')',\n    callback_url: parsed.callback_url ?? 'http://localhost:5000/api/webhooks/n8n-callback'\n  }\n}];"
      }
    },
    {
      "id": "send-error-callback",
      "name": "Send Error Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        700
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callback_url }}",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_id: $json.post_id, platform: $json.platform, status: $json.status, platform_post_id: $json.platform_post_id, error: $json.error }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
