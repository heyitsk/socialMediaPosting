                      "operation": "equals",
                      "singleValue": true
                    },
                    "rightValue": "IMAGE"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              }
            },
            {
              "outputKey": "VIDEO",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "mt-video",
                    "leftValue": "={{ $json.media_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "singleValue": true
                    },
                    "rightValue": "VIDEO"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              }
            },
            {
              "outputKey": "CAROUSEL",
              "renameOutput": true,
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "mt-carousel",
                    "leftValue": "={{ $json.media_type }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals",
                      "singleValue": true
                    },
                    "rightValue": "CAROUSEL"
                  }
                ],
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                }
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
