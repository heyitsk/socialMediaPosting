    {
      "id": "aaa00004-0000-0000-0000-000000000004",
      "name": "Filter Due Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 400],
      "parameters": {
        "jsCode": "const now = new Date();\nconst due = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  let scheduledDate;\n  if (row.scheduled_datetime !== undefined && String(row.scheduled_datetime).trim() !== '') {\n    const val = row.scheduled_datetime;\n    if (typeof val === 'number') {\n      scheduledDate = new Date((val - 25569) * 86400 * 1000);\n    } else {\n      scheduledDate = new Date(String(val).replace(' ', 'T'));\n    }\n  } else if (row.scheduled_date && row.scheduled_time) {\n    scheduledDate = new Date(row.scheduled_date + 'T' + row.scheduled_time);\n  } else {\n    continue;\n  }\n  if (!isNaN(scheduledDate.getTime()) && scheduledDate <= now) {\n    due.push(item);\n  }\n}\nreturn due;"
      }
    },
